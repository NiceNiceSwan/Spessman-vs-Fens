; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Spessmen vs Fens"
run/main_scene="res://Code/UI/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://Graphics/bubber_jacob.png"

[autoload]

Enums="*res://Global/Enums.gd"
Signals="*res://Global/Signals.gd"
Defines="*res://Global/defines.gd"
SaveData="*res://Global/SaveData.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=768
window/size/resizable=false
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Spessmen vs Fens"

[editor]

movie_writer/movie_file="F:/programy/godot projects/pvz_clone/video/video.avi"
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[filesystem]

import/blender/enabled=false

[input]

click={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}
